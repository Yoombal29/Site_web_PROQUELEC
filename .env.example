# ============================================
# PROQUELEC - Configuration d'environnement
# ============================================
# Copier ce fichier en .env et ajuster les valeurs
# cp .env.example .env

# ─── SERVER ──────────────────────────────────
PORT=3000
NODE_ENV=development
APP_VERSION=1.0.0

# ─── DATABASE (PostgreSQL) ──────────────────
DATABASE_URL=postgres://postgres:password@localhost:5436/proquelec
DB_HOST=127.0.0.1
DB_PORT=5437
DB_NAME=proquelec

# ─── AUTHENTIFICATION ───────────────────────
# Générer une clé forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme-en-production
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@proquelec.sn
ADMIN_PASSWORD=Admin@123

# ─── IA (Cloud) ─────────────────────────────
# Activer l'IA distante
PROQUELEC_REMOTE_AI=0

# Fournisseur: openai | anthropic | gemini | deepseek
PROQUELEC_AI_PROVIDER=openai
PROQUELEC_API_KEY=
PROQUELEC_AI_MODEL=gpt-4o

# API personnalisée (optionnel)
PROQUELEC_CUSTOM_API_URL=

# ─── IA - Images ─────────────────────────────
PROQUELEC_REMOTE_IMAGE_API=
PROQUELEC_IMAGE_API_KEY=

# ─── IA - Vision ─────────────────────────────
# Si non défini, utilise PROQUELEC_REMOTE_IMAGE_API
PROQUELEC_REMOTE_VISION_API=

# ─── FEATURE FLAGS ─────────────────────────
ENABLE_PAYMENTS=false
ENABLE_COSSUEL=false
ENABLE_EMAIL=false
ENABLE_SIGNATURE=false
MOCK_MODE=true

# ─── EMAIL (SMTP) ──────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@proquelec.sn

# ─── PAIEMENTS ──────────────────────────────
PAYDUNYA_API_KEY=
PAYDUNYA_SECRET_KEY=
WAVE_API_KEY=
ORANGE_CLIENT_ID=
CINETPAY_API_KEY=
FW_SECRET_KEY=

# ─── COSSUEL (Sync Inspections) ────────────
COSSUEL_API_URL=https://api.cossuel.sn/v1
COSSUEL_API_KEY=

# ─── FRONTEND ───────────────────────────────
VITE_PORT=5175
VITE_API_URL=http://127.0.0.1:3010
VITE_JWT_SECRET=

# ─── LOGGING ────────────────────────────────
LOG_LEVEL=info

# ─── DOCKER ─────────────────────────────────
SITE_APP_PORT=3000
SITE_DB_PORT=5436
POSTGRES_PASSWORD=password
